{
  "name": "imgsquish",
  "version": "0.1.0",
  "description": "Compress and resize JPEG / PNG / WebP images from the command line. Powered by sharp, fast and batteries-included.",
  "type": "module",
  "bin": {
    "imgsquish": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Riyoway/ImageSquish.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Riyoway/ImageSquish#readme",
  "bugs": "https://github.com/Riyoway/ImageSquish/issues",
  "keywords": [
    "image",
    "compress",
    "compression",
    "optimize",
    "minify",
    "jpeg",
    "png",
    "webp",
    "resize",
    "sharp",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@image-compressor/core": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
